# ─────────────────────────────────────────────────────────────────────────────
# EDGE FUNCTION ENVIRONMENT — names and shapes only. Never commit a value.
#
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected by the platform and
# must NOT be set here. A service_role key was committed to this repository once
# and is still in its history; see ROTATION.md.
# ─────────────────────────────────────────────────────────────────────────────

# Signing key for the JWTs this platform issues. At least 32 characters, and
# never a value that has appeared in documentation. Verification fails closed.
JWT_SECRET=

# NaloPay — the only payment provider.
NALO_MERCHANT_ID=
NALO_SECRET=
NALO_AUTH_KEY=
NALO_BASE_URL=https://api.nalopay.com
NALO_CALLBACK_URL=

# SMS
AT_API_KEY=
AT_USERNAME=
AT_SENDER_ID=

# Where links point. Three audiences, three hostnames — see _shared/urls.ts.
PUBLIC_SITE_URL=https://abbiewealthsusu.com
MEMBER_URL=https://my.abbiewealthsusu.com
FRONTEND_URL=https://admin.abbiewealthsusu.com

# Percentage added to a contribution to cover the mobile-money fee.
PAYMENT_SERVICE_CHARGE_PCT=1.5

# Explicit opt-in for development payments. A missing provider key must never
# become free contributions, so this is an inference nothing else makes.
ALLOW_DEV_PAYMENTS=false
