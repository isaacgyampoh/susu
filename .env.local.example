# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://qaelfwtbaehdwhnxkpid.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# The member portal is a DIFFERENT hostname from this console.
# Never derive it from window.location.origin — middleware 404s /m/* on the
# admin host, so an origin-built link is dead in the member's hand.
NEXT_PUBLIC_MEMBER_URL=https://my.abbiewealthsusu.com

# The PUBLIC website — the application form and the registration payment page.
# Deliberately separate from FRONTEND_URL, which in this deployment points at
# the admin console: building a public link from that produced
# admin.abbiewealthsusu.com/join/pay/... — reachable, but the wrong front door.
NEXT_PUBLIC_WEB_URL=https://my.abbiewealthsusu.com
